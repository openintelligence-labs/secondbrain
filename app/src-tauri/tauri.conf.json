{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecondBrain",
  "version": "0.2.0",
  "identifier": "com.openintelligencelabs.secondbrain",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SecondBrain",
        "url": "index.html",
        "width": 1080,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Local-first personal AI memory.",
    "longDescription": "SecondBrain captures your screen, browser, and documents, indexes them on-device, and serves them to Claude/Cursor/Codex via MCP. No data leaves your machine unless you opt into a hosted LLM.",
    "copyright": "Copyright © 2026 Open Intelligence Labs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "providerShortName": null
    }
  }
}
